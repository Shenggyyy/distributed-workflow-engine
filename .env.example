# Copy to .env, then explicitly load it with:
# uv run --locked engine check-config --env-file .env
# DWE_ environment variables override this file.
# Use a dedicated dotenv file: unknown keys are rejected.
# This example contains no credentials.
DWE_ENVIRONMENT=development
DWE_LOG_LEVEL=INFO
DWE_API_HOST=127.0.0.1
DWE_API_PORT=8000

# Optional database settings (check-db only at this stage).
# Initialize the local secret with: python scripts/init_dev_secrets.py
# Match DWE_DATABASE_PORT to your Docker published port (for example, 15432).
DWE_DATABASE_HOST=127.0.0.1
DWE_DATABASE_PORT=5432
DWE_DATABASE_NAME=workflow
DWE_DATABASE_USER=workflow_admin
# Choose exactly one password source when using the database:
# DWE_DATABASE_PASSWORD_FILE=secrets/postgres_password.txt
# Supply DWE_DATABASE_PASSWORD through the process environment as an alternative.
DWE_DATABASE_POOL_SIZE=5
DWE_DATABASE_POOL_TIMEOUT_SECONDS=5
DWE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
DWE_DATABASE_STATEMENT_TIMEOUT_MS=10000
