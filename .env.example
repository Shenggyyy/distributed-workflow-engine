# Copy to .env, then explicitly load it with:
# uv run --locked engine check-config --env-file .env
# DWE_ environment variables override this file.
# Use a dedicated dotenv file: unknown keys are rejected.
# This example contains no credentials.
DWE_ENVIRONMENT=development
DWE_LOG_LEVEL=INFO
DWE_API_HOST=127.0.0.1
DWE_API_PORT=8000
